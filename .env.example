# ---------------------------------------------------------------------------
# finance_agents - Beispielkonfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# Die .env selbst wird NIEMALS committed.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Datenbank (Postgres) --------------------------------------------------
POSTGRES_USER=finance
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=finance_agents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- SEC EDGAR -------------------------------------------------------------
# Pflicht laut SEC Fair-Access-Policy: identifizierender User-Agent mit E-Mail.
SEC_USER_AGENT="finance_agents/0.1 (your.email@example.com)"
SEC_REQUESTS_PER_SECOND=8

# --- FRED (Makrodaten fuer WACC) ------------------------------------------
# Kostenloser API-Key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- LLM (Kostenstufe 0 = lokal via Ollama) --------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Auf CPU dauert ein Lauf mehrere Minuten, daher grosszuegig gesetzt.
LLM_TIMEOUT_SECONDS=600
LLM_TEMPERATURE=0.1

# --- Kostenkontrolle -------------------------------------------------------
# Harte Obergrenze pro Analyselauf. 0 = keine externen Kosten erlaubt.
MAX_COST_USD_PER_RUN=0
MAX_EXTERNAL_REQUESTS_PER_RUN=400

# --- Caching ---------------------------------------------------------------
CACHE_DIR=data/cache
CACHE_ENABLED=true

# --- Optionale, kostenpflichtige Provider (Stufe 0: leer lassen) ----------
FMP_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_KEY=
TAVILY_API_KEY=
